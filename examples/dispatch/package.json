{
  "name": "company-agents",
  "version": "0.2.0",
  "private": true,
  "description": "A small, runnable company-agent scaffold with local terminal chat and scoped skills",
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=24.22.1 <25"
  },
  "scripts": {
    "chat": "node src/cli.ts",
    "auth": "node src/auth.ts",
    "demo": "npm run chat -- helper --demo",
    "sequence": "node src/sequence.ts",
    "parallel": "node src/sequence.ts --parallel",
    "agents": "npm run chat -- --list",
    "skills": "npm run chat -- --skills",
    "check": "tsc --noEmit && node src/check-definitions.ts",
    "foreman": "node src/cli.ts foreman",
    "schedules": "node src/schedules.ts"
  },
  "devDependencies": {
    "@types/node": "24.19.1",
    "typescript": "6.0.3"
  }
}
