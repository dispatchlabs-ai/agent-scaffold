{
  "name": "company-agents",
  "version": "0.2.0",
  "private": true,
  "description": "A small, runnable company-agent scaffold with local terminal chat and scoped skills",
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=24.22.1 <25"
  },
  "scripts": {
    "chat": "node src/cli.ts",
    "auth": "node src/auth.ts",
    "demo": "npm run chat -- helper --demo",
    "agents": "npm run chat -- --list",
    "skills": "npm run chat -- --skills",
    "check": "tsc --noEmit && node src/check-definitions.ts",
    "foreman": "node src/cli.ts foreman",
    "link-runner": "node src/link-runner.ts"
  },
  "dependencies": {
    "@dispatch/runner": "https://github.com/dispatchlabs-ai/dispatch/releases/download/runner-v0.6.0-alpha.4/dispatch-runner-0.6.0.tgz",
    "@earendil-works/pi-ai": "1.3.0",
    "@earendil-works/pi-durable": "1.3.0"
  },
  "devDependencies": {
    "@types/node": "24.19.1",
    "typescript": "6.0.3"
  }
}
