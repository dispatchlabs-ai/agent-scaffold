{
  "name": "company-agents",
  "version": "0.1.0",
  "private": true,
  "description": "A small, runnable company-agent scaffold with local terminal chat and scoped skills",
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=24 <26"
  },
  "scripts": {
    "chat": "node src/cli.ts",
    "demo": "npm run chat -- helper --demo",
    "agents": "npm run chat -- --list",
    "skills": "npm run chat -- --skills",
    "check": "tsc --noEmit"
  },
  "dependencies": {
    "@dispatch/runner": "https://github.com/dispatchlabs-ai/dispatch/releases/download/runner-v0.6.0-alpha.1/dispatch-runner-0.6.0.tgz",
    "@earendil-works/pi-ai": "1.3.0"
  },
  "devDependencies": {
    "@types/node": "24.19.1",
    "typescript": "6.0.3"
  }
}
